DATABASE_URL=postgresql://pilots:pilots_local@localhost:5432/pilots
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_minimum_32_chars_long_secret_key
JWT_REFRESH_SECRET=change_me_different_refresh_secret_key
PORT=3000
NODE_ENV=development

# Logging: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Redis Sentinel HA (optional — leave blank for single-node Redis)
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=mymaster

# PostgreSQL read replica (optional — falls back to primary if blank)
POSTGRES_REPLICA_URL=
